diff --git a/apps/api/src/scraper/scrapeURL/engines/pi-resilient/fetch.ts b/apps/api/src/scraper/scrapeURL/engines/pi-resilient/fetch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7f821920e45c9ee641a8c1b6f2763298aef26346
--- /dev/null
+++ b/apps/api/src/scraper/scrapeURL/engines/pi-resilient/fetch.ts
@@ -0,0 +1,83 @@
+// fcpi: auxiliary downloads in the pi-resilient profile: .gz sitemaps, PDF and document
+// downloads outside the adapter, and map's redirect resolution. They go through the retrieval
+// service's POST /internal/fetch, under the same SSRF, redirect, size, pacing and Cloud-denylist
+// policy as page acquisitions, without the quality check or the browser. The service streams
+// the target's body back and names the target's status, content type and final URL in x-fcpi-*
+// headers; this rebuilds the target's response from them, so callers read it unchanged.
+import * as undici from "undici";
+import { randomUUID } from "node:crypto";
+import { config } from "../../../../config";
+import { PiRetrievalError } from "../../error";
+
+export const usePiResilient =
+  config.PI_RETRIEVAL_URL !== undefined && config.PI_RETRIEVAL_URL !== "";
+
+const NULL_BODY_STATUSES = new Set([101, 204, 205, 304]);
+
+export async function piFetch(
+  url: string,
+  init: {
+    method?: "GET" | "HEAD";
+    headers?: Record<string, string>;
+    signal?: AbortSignal | null;
+    maxBytes?: number;
+    purpose: "sitemap" | "document" | "discovery";
+    timeoutMs?: number;
+  },
+): Promise<undici.Response> {
+  let res: undici.Response;
+  try {
+    res = await undici.fetch(`${config.PI_RETRIEVAL_URL}/internal/fetch`, {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${config.PI_RETRIEVAL_TOKEN}`,
+        "content-type": "application/json",
+      },
+      body: JSON.stringify({
+        requestId: randomUUID(),
+        url,
+        method: init.method ?? "GET",
+        headers: init.headers ?? {},
+        purpose: init.purpose,
+        maxBytes: init.maxBytes ?? null,
+        deadline: new Date(Date.now() + (init.timeoutMs ?? 30_000)).toISOString(),
+      }),
+      signal: init.signal ?? undefined,
+    });
+  } catch (error) {
+    if (init.signal?.aborted) throw error;
+    throw new PiRetrievalError(
+      "RETRIEVAL_SERVICE_UNAVAILABLE",
+      "The retrieval service could not be reached.",
+      true,
+    );
+  }
+  if (res.status !== 200) {
+    const body = (await res.json().catch(() => null)) as {
+      failure?: { class: string; detail: string; retryable: boolean; retryAfter: number | null };
+    } | null;
+    const f = body?.failure;
+    throw new PiRetrievalError(
+      f?.class ?? "RETRIEVAL_SERVICE_ERROR",
+      f?.detail ?? `The retrieval service answered HTTP ${res.status}.`,
+      f?.retryable ?? res.status >= 500,
+      f?.retryAfter ?? null,
+    );
+  }
+  const status = Number(res.headers.get("x-fcpi-target-status"));
+  const headers = new undici.Headers();
+  const contentType = res.headers.get("content-type");
+  if (contentType) headers.set("content-type", contentType);
+  const targetLength = res.headers.get("x-fcpi-target-content-length");
+  if (targetLength) headers.set("content-length", targetLength);
+  const bodiless = NULL_BODY_STATUSES.has(status) || init.method === "HEAD";
+  if (bodiless) await res.body?.cancel().catch(() => {});
+  const out = new undici.Response(bodiless ? null : res.body, {
+    status,
+    headers,
+  });
+  Object.defineProperty(out, "url", {
+    value: res.headers.get("x-fcpi-final-url") ?? url,
+  });
+  return out;
+}
diff --git a/apps/api/src/scraper/scrapeURL/engines/pi-resilient/index.ts b/apps/api/src/scraper/scrapeURL/engines/pi-resilient/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5c07e6a3ca81944fca7ee50e84a30a63136138bc
--- /dev/null
+++ b/apps/api/src/scraper/scrapeURL/engines/pi-resilient/index.ts
@@ -0,0 +1,209 @@
+// fcpi: the pi-resilient engine adapter (FIRECRAWL_PI_SPEC.md §8.1). In the pi-resilient
+// profile (PI_RETRIEVAL_URL set) every acquisition is one call to the project retrieval
+// service's POST /internal/acquire. The service owns target validation, SSRF and redirect
+// checks, egress, domain pacing, global permits, the four-attempt budget per logical page
+// and browser rendering. This file only translates: the request's fields go out, an
+// EngineScrapeResult or a typed PiRetrievalError comes back. PDFs and documents are parsed by
+// the upstream engines from the bytes this acquisition returned, never downloaded again.
+import * as undici from "undici";
+import { createHash, randomUUID } from "node:crypto";
+import { config } from "../../../../config";
+import type { Meta } from "../..";
+import type { EngineScrapeResult, FeatureFlag } from "..";
+import { AddFeatureError, PiRetrievalError } from "../../error";
+import { specialtyScrapeCheck } from "../utils/specialtyHandler";
+import { scrapePDF } from "../pdf";
+import { scrapeDocument } from "../document";
+
+// Defined in ./fetch, a leaf module, so the download helpers can use it without an import cycle.
+export { usePiResilient } from "./fetch";
+
+// The features this deployment really serves. Screenshots and actions have result hooks in
+// the retrieval and browser services but stay unregistered until M7; proxies, geo and stealth
+// arrive with M6; skipTlsVerification is refused, because TLS is always verified (spec §9.2).
+export const piResilientFeatures: { [F in FeatureFlag]: boolean } = {
+  actions: false,
+  waitFor: true,
+  screenshot: false,
+  "screenshot@fullScreen": false,
+  pdf: true,
+  document: true,
+  audio: false,
+  video: false,
+  atsv: false,
+  location: false,
+  mobile: false,
+  skipTlsVerification: false,
+  useFastMode: true,
+  stealthProxy: false,
+  branding: false,
+  disableAdblock: true,
+};
+
+// The service's own ceiling is 90 s from a logical page's first attempt (spec §9.3).
+const MAX_ACQUISITION_MS = 90_000;
+
+function purposeOf(meta: Meta): "page" | "robots" | "sitemap" {
+  if (meta.internalOptions.teamId === "robots-txt") return "robots";
+  if (meta.internalOptions.teamId === "sitemap") return "sitemap";
+  return "page";
+}
+
+export async function scrapeURLWithPiResilient(
+  meta: Meta,
+): Promise<EngineScrapeResult> {
+  const unsupported = [...meta.featureFlags].filter(
+    f => !piResilientFeatures[f],
+  );
+  if (unsupported.length > 0) {
+    throw new PiRetrievalError(
+      "UNSUPPORTED_CAPABILITY",
+      `This deployment does not offer: ${unsupported.join(", ")}.`,
+    );
+  }
+
+  const remaining = Math.min(
+    meta.abort.scrapeTimeout() ?? MAX_ACQUISITION_MS,
+    MAX_ACQUISITION_MS,
+  );
+  const url = meta.rewrittenUrl ?? meta.url;
+  const purpose = purposeOf(meta);
+  const request = {
+    requestId: randomUUID(),
+    // The scrape job's id: stable across NuQ requeues and upstream's own retries, so all of
+    // them draw on one attempt budget in the service (review finding R3). Upstream gives every
+    // robots.txt and sitemap fetch of a crawl one id ("robots-txt;"/"sitemap;" + the crawl's), so
+    // for those the URL is part of the key: each document keeps its own budget.
+    logicalAcquisitionId:
+      purpose === "page"
+        ? meta.id
+        : `${meta.id}|${createHash("sha256").update(url).digest("hex").slice(0, 16)}`,
+    principalId: meta.internalOptions.teamId ?? null,
+    jobId: meta.id,
+    crawlId: meta.internalOptions.crawlId ?? null,
+    url,
+    deadline: new Date(Date.now() + Math.max(remaining, 0)).toISOString(),
+    purpose,
+    expect: meta.featureFlags.has("pdf")
+      ? "pdf"
+      : meta.featureFlags.has("document")
+        ? "document"
+        : "html",
+    headers: meta.options.headers ?? {},
+    waitFor: meta.options.waitFor ?? 0,
+    fast: meta.featureFlags.has("useFastMode"),
+  };
+
+  let response: undici.Response;
+  try {
+    response = await undici.fetch(`${config.PI_RETRIEVAL_URL}/internal/acquire`, {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${config.PI_RETRIEVAL_TOKEN}`,
+        "content-type": "application/json",
+      },
+      body: JSON.stringify(request),
+      signal: meta.abort.asSignal(),
+    });
+  } catch (error) {
+    if (meta.abort.asSignal().aborted) throw error;
+    throw new PiRetrievalError(
+      "RETRIEVAL_SERVICE_UNAVAILABLE",
+      "The retrieval service could not be reached.",
+      true,
+    );
+  }
+  if (response.status !== 200) {
+    throw new PiRetrievalError(
+      "RETRIEVAL_SERVICE_ERROR",
+      `The retrieval service answered HTTP ${response.status}.`,
+      response.status >= 500,
+    );
+  }
+  const result = (await response.json()) as {
+    ok: boolean;
+    attemptId: string;
+    attemptsUsed: number;
+    strategy: string | null;
+    finalUrl: string;
+    targetStatus: number;
+    contentType: string | null;
+    body?: string;
+    bodyBase64?: string;
+    bytes: number;
+    quality?: { verdict: string };
+    failure?: {
+      class: string;
+      detail: string;
+      retryable: boolean;
+      retryAfter: number | null;
+    } | null;
+  };
+
+  meta.logger.info("pi-resilient acquisition", {
+    logicalAcquisitionId: request.logicalAcquisitionId,
+    attemptId: result.attemptId,
+    attemptsUsed: result.attemptsUsed,
+    strategy: result.strategy,
+    targetStatus: result.targetStatus,
+    bytes: result.bytes,
+    verdict: result.quality?.verdict ?? null,
+    failure: result.failure?.class ?? null,
+  });
+
+  if (!result.ok) {
+    const f = result.failure ?? {
+      class: "RETRIEVAL_FAILED",
+      detail: "",
+      retryable: false,
+      retryAfter: null,
+    };
+    throw new PiRetrievalError(f.class, f.detail, f.retryable, f.retryAfter);
+  }
+
+  const contentType = result.contentType ?? undefined;
+  // PDFs, documents and other binary types follow upstream's content-type rules; the file is
+  // the one this acquisition returned, handed to the parser as a prefetch.
+  if (result.bodyBase64 !== undefined) {
+    try {
+      await specialtyScrapeCheck(
+        meta.logger.child({ method: "pi-resilient/specialtyScrapeCheck" }),
+        contentType ? { "content-type": contentType } : undefined,
+        {
+          url: result.finalUrl,
+          pageStatusCode: result.targetStatus,
+          content: "",
+          file: { name: "", content: result.bodyBase64 },
+          usedMobileProxy: false,
+        } as any,
+      );
+    } catch (error) {
+      if (error instanceof AddFeatureError && error.pdfPrefetch) {
+        return await scrapePDF({ ...meta, pdfPrefetch: error.pdfPrefetch });
+      }
+      if (error instanceof AddFeatureError && error.documentPrefetch) {
+        return await scrapeDocument({
+          ...meta,
+          documentPrefetch: error.documentPrefetch,
+        });
+      }
+      throw error;
+    }
+    throw new PiRetrievalError(
+      "UNSUPPORTED_CONTENT",
+      `Content type ${contentType ?? "(none)"} is neither HTML, a PDF nor a document.`,
+    );
+  }
+
+  return {
+    url: result.finalUrl,
+    html: result.body ?? "",
+    statusCode: result.targetStatus,
+    contentType,
+    proxyUsed: "basic",
+  };
+}
+
+export function piResilientMaxReasonableTime(meta: Meta): number {
+  return MAX_ACQUISITION_MS + (meta.options.waitFor ?? 0);
+}
diff --git a/apps/api/src/scraper/scrapeURL/error.ts b/apps/api/src/scraper/scrapeURL/error.ts
index 1e28043bdaeca7e04f6315f90548869ccad8a0e7..de18259d12c687460b216e1c2a300028b43b2fa3 100644
--- a/apps/api/src/scraper/scrapeURL/error.ts
+++ b/apps/api/src/scraper/scrapeURL/error.ts
@@ -719,3 +719,47 @@ export class ScrapeRetryLimitError extends TransportableError {
     return x;
   }
 }
+
+// fcpi: a typed failure returned by the project retrieval service, or a capability this
+// deployment does not offer. The class names come from FIRECRAWL_PI_SPEC.md §9.2 (for example
+// AUTH_REQUIRED, RATE_LIMITED, BLOCKED_PUBLIC_CONTENT, SSRF_DENIED, ATTEMPT_BUDGET_EXHAUSTED,
+// PROXY_REQUIRED, UNSUPPORTED_CAPABILITY). It is fatal to the engine loop, so no upstream retry
+// or feature toggle acquires the page again after the service has decided.
+export class PiRetrievalError extends TransportableError {
+  constructor(
+    public failureClass: string,
+    public detail: string,
+    public retryable: boolean = false,
+    public retryAfter: number | null = null,
+  ) {
+    super(
+      "SCRAPE_FCPI_RETRIEVAL",
+      `Retrieval failed: ${failureClass}. ${detail}` +
+        (retryAfter !== null ? ` Retry after ${retryAfter} s.` : ""),
+    );
+  }
+
+  serialize() {
+    return {
+      ...super.serialize(),
+      failureClass: this.failureClass,
+      detail: this.detail,
+      retryable: this.retryable,
+      retryAfter: this.retryAfter,
+    };
+  }
+
+  static deserialize(
+    _: ErrorCodes,
+    data: ReturnType<typeof this.prototype.serialize>,
+  ) {
+    const x = new PiRetrievalError(
+      data.failureClass,
+      data.detail,
+      data.retryable,
+      data.retryAfter,
+    );
+    x.stack = data.stack;
+    return x;
+  }
+}
