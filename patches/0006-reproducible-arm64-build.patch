-# Install dependencies
+# Install dependencies (pnpm --frozen-lockfile; the native install runs cargo --locked)
 RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
     --mount=type=cache,target=/usr/local/cargo/registry \
     --mount=type=cache,target=/app/native/target \
@@ -60,7 +79,13 @@ RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
 COPY . .
 
 # Build the application from a clean output directory.
-RUN rm -rf dist && pnpm run build
+# fcpi: without npm_config_verify_deps_before_run=false, pnpm 11 re-runs the install before `run`
+# whenever it judges node_modules stale, as it does after COPY . . over a cached install layer;
+# that recompiles the native module into native/target outside the cache mount, so the image's
+# contents would depend on the builder's cache. The test refuses a native/target that holds
+# anything beyond the empty mount point the cache mount leaves.
+RUN rm -rf dist && npm_config_verify_deps_before_run=false pnpm run build && \
+    [ -z "$(ls -A native/target 2>/dev/null)" ]
