-# syntax=docker/dockerfile:1
-FROM node:22-slim AS base
+# fcpi: reproducible linux/arm64 build (evidence/M0/INTERPRETATION.md §4; decisions D4 and D6).
+# Every base image is pinned by its linux/arm64 manifest digest, the Rust toolchain comes from a
+# digest-pinned image instead of rustup's installer, cargo runs --locked against the committed
+# native/Cargo.lock, apt reads a fixed Debian snapshot, and the FoundationDB client is checked
+# against its published SHA-256. Each toolchain prints its version into the build log.
+# Upstream's "# syntax=docker/dockerfile:1" line is gone: it pulls a floating frontend image, and
+# BuildKit's built-in frontend handles this file.
+ARG DEBIAN_SNAPSHOT=20260925T000000Z
+
+# node:22.23.3-bookworm-slim, linux/arm64
+FROM node:22.23.3-bookworm-slim@sha256:a0ddbc73510e98f5e824fd64266ffe1c2c343ba9cf260d95ca2985ad632a3f3e AS base
 
 ENV PNPM_HOME="/pnpm"
 ENV PATH="$PNPM_HOME:$PATH"
 ENV CI=true
 
-RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
+RUN corepack enable && corepack prepare pnpm@11.4.0 --activate && node --version && pnpm --version
 
-# Build Go shared library
-FROM golang:1.24 AS go-build
+# Build Go shared library (D4: the newest Go 1.27 patch; the image sets GOTOOLCHAIN=local)
+# golang:1.27.1-bookworm, linux/arm64
+FROM golang:1.27.1-bookworm@sha256:1668bbf856490c9bd0b77204ae1cdaebe273dc459b5eeb3a31a4ddc78ca6fae1 AS go-build
 WORKDIR /app
 COPY sharedLibs/go-html-to-md ./sharedLibs/go-html-to-md
 
-RUN cd sharedLibs/go-html-to-md && \
-    go mod download && \
+RUN go version && go env GOTOOLCHAIN && cd sharedLibs/go-html-to-md && \
+    go mod download && go mod verify && \
     go build -o libhtml-to-markdown.so -buildmode=c-shared html-to-markdown.go
 
+# The Rust toolchain, copied into the build stage below. rust:1.98.1-slim-bookworm, linux/arm64
+FROM rust:1.98.1-slim-bookworm@sha256:3ebe98baef5911f8461cf81ba05644374a3c5ef1f8a33db3977bd4175f5ff1fc AS rust
+
 FROM base AS build
 WORKDIR /app
+ARG DEBIAN_SNAPSHOT
 
-# Install system dependencies
-RUN apt-get update && apt-get install -y \
+# Install system dependencies from the fixed snapshot; the installed versions are printed.
+RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
+      "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list.d/debian.sources && \
+    apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y \
     curl \
     build-essential \
     pkg-config \
     python3 \
-    && rm -rf /var/lib/apt/lists/*
+    && rm -rf /var/lib/apt/lists/* && \
+    echo "fcpi-apt-build: snapshot=$DEBIAN_SNAPSHOT" && dpkg-query -W -f='fcpi-apt-build: ${Package}=${Version}\n'
 
 # FoundationDB client library (libfdb_c + headers), needed by the
 # `foundationdb` npm package at install time on arches without prebuilds
 ARG FDB_VERSION=7.3.63
+ARG FDB_CLIENTS_AARCH64_SHA256=a3c451ddb8242cc2396ba3419e1f3c9b283a64ea2eaff555377f4503bf9c3a64
 RUN ARCH=$(dpkg --print-architecture) && \
-    case "$ARCH" in arm64) FDB_ARCH=aarch64 ;; *) FDB_ARCH=$ARCH ;; esac && \
+    [ "$ARCH" = arm64 ] || { echo "fcpi: this build is linux/arm64 only" >&2; exit 1; } && \
     curl -fsSL -o /tmp/fdb-clients.deb \
-      "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_${FDB_ARCH}.deb" && \
+      "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_aarch64.deb" && \
+    echo "${FDB_CLIENTS_AARCH64_SHA256}  /tmp/fdb-clients.deb" | sha256sum -c - && \
     dpkg -i /tmp/fdb-clients.deb && rm /tmp/fdb-clients.deb
 
-# Install Rust
+# Rust, from the digest-pinned image above; native/rust-toolchain.toml names the same version.
 ENV RUSTUP_HOME=/usr/local/rustup \
     CARGO_HOME=/usr/local/cargo \
     PATH=/usr/local/cargo/bin:$PATH
-
