     git \
     procps \
     curl \
-    && rm -rf /var/lib/apt/lists/*
+    && rm -rf /var/lib/apt/lists/* && \
+    echo "fcpi-apt-runtime: snapshot=$DEBIAN_SNAPSHOT" && dpkg-query -W -f='fcpi-apt-runtime: ${Package}=${Version}\n'
 
 # FoundationDB client library (libfdb_c + fdbcli)
 ARG FDB_VERSION=7.3.63
+ARG FDB_CLIENTS_AARCH64_SHA256=a3c451ddb8242cc2396ba3419e1f3c9b283a64ea2eaff555377f4503bf9c3a64
 RUN ARCH=$(dpkg --print-architecture) && \
-    case "$ARCH" in arm64) FDB_ARCH=aarch64 ;; *) FDB_ARCH=$ARCH ;; esac && \
+    [ "$ARCH" = arm64 ] || { echo "fcpi: this build is linux/arm64 only" >&2; exit 1; } && \
     curl -fsSL -o /tmp/fdb-clients.deb \
-      "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_${FDB_ARCH}.deb" && \
+      "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_aarch64.deb" && \
+    echo "${FDB_CLIENTS_AARCH64_SHA256}  /tmp/fdb-clients.deb" | sha256sum -c - && \
     dpkg -i /tmp/fdb-clients.deb && rm /tmp/fdb-clients.deb
 
 EXPOSE 8080
 WORKDIR /app
 ARG GIT_SHA=unknown
 ENV FIRECRAWL_BUILD_SHA=$GIT_SHA
+# fcpi: the ordered patch series applied on top of FIRECRAWL_BUILD_SHA (patches/series.json).
+ARG FCPI_PATCH_SERIES_SHA256=unknown
+ENV FCPI_PATCH_SERIES_SHA256=$FCPI_PATCH_SERIES_SHA256
 
 # Copy built application
 COPY --from=build /app/node_modules ./node_modules
