+// fcpi: in the pi-resilient profile a download goes through the retrieval service, which
+// verifies TLS itself whatever the caller asks.
+function guardedFetch(
+  url: string,
+  skipTlsVerification: boolean,
+  init: undici.RequestInit | undefined,
+  maxSize: number | undefined,
+): Promise<undici.Response> {
+  if (usePiResilient) {
+    return piFetch(url, {
+      headers: init?.headers as Record<string, string> | undefined,
+      signal: init?.signal ?? null,
+      maxBytes: maxSize,
+      purpose: /sitemap|\.gz(\?|$)/i.test(url) ? "sitemap" : "document",
+    });
+  }
+  return undici.fetch(url, {
+    ...init,
+    redirect: "follow",
+    dispatcher: getSecureDispatcher(skipTlsVerification),
+  });
+}
