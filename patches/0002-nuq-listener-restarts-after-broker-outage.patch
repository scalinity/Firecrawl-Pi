+  private scheduleListenerRestart() {
+    if (this.shuttingDown || this.listenerRetryTimer) return;
+    const delay = this.listenerRetryMs;
+    this.listenerRetryMs = Math.min(this.listenerRetryMs * 2, 5000);
+    this.listenerRetryTimer = setTimeout(() => {
+      this.listenerRetryTimer = null;
