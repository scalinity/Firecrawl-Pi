+// fcpi: a search failure in the pi-resilient profile, named by the retrieval service, which answers
+// the SearXNG-compatible route (FIRECRAWL_PI_SPEC.md §13). It reaches the caller as a typed error
+// with its HTTP status, never as an empty result (review finding S6).
+export class PiSearchError extends Error {
+  constructor(
+    public failureClass: string,
+    public detail: string,
+    public status: number,
+    public retryable: boolean,
+    public retryAfter: number | null,
+  ) {
+    super(`Search failed: ${failureClass}. ${detail}`);
+  }
+}
+
+// fcpi: the pi-resilient profile's search: one request to the retrieval service's route, whose answer
+// is results, a true empty list, or a typed failure. Nothing here turns a failure into no results.
+async function piSearxngSearch(
+  q: string,
+  options: SearchOptions,
+): Promise<SearchV2Response> {
+  if (Math.max(options.num_results, 0) === 0) return { web: [] };
+  if (!config.SEARXNG_ENDPOINT) {
+    throw new PiSearchError(
+      "SEARCH_BACKEND_UNAVAILABLE",
+      "No search route is configured (SEARXNG_ENDPOINT is unset).",
+      503,
+      false,
+      null,
+    );
+  }
+  const url = new URL(
+    config.SEARXNG_ENDPOINT!.replace(/\/$/, "") + "/search",
+  );
+  url.searchParams.set("q", q);
+  url.searchParams.set("format", "json");
+  url.searchParams.set("pageno", String(options.page ?? 1));
+  if (options.lang) url.searchParams.set("language", options.lang);
+  let res: undici.Response;
+  try {
+    res = await undici.fetch(url, {
+      headers: { accept: "application/json" },
+      signal: AbortSignal.timeout(15_000),
+    });
+  } catch (error) {
+    // The route answers within its own 10-second deadline; no answer in 15 seconds is a timeout.
+    if ((error as Error)?.name === "TimeoutError") {
+      throw new PiSearchError(
+        "SEARCH_TIMEOUT",
+        "The retrieval service's search route did not answer within 15 seconds.",
+        504,
+        true,
+        null,
+      );
+    }
+    throw new PiSearchError(
+      "SEARCH_BACKEND_UNAVAILABLE",
+      "The retrieval service's search route could not be reached.",
+      503,
+      true,
+      null,
+    );
+  }
+  const body = (await res.json().catch(() => null)) as any;
+  if (res.status !== 200) {
+    const f = body?.failure;
+    throw new PiSearchError(
+      f?.class ?? "SEARCH_BACKEND_ERROR",
+      f?.detail ?? `The retrieval service answered HTTP ${res.status}.`,
+      res.status,
+      f?.retryable ?? res.status >= 500,
+      f?.retryAfter ?? null,
+    );
+  }
+  if (!body || !Array.isArray(body.results)) {
+    throw new PiSearchError(
+      "SEARCH_BACKEND_ERROR",
+      "The retrieval service's search answer has no results list.",
+      502,
+      true,
+      null,
+    );
+  }
+  const web: WebSearchResult[] = body.results
+    .slice(0, Math.max(options.num_results, 0))
+    .map((a: any) => ({ url: a.url, title: a.title, description: a.content }));
+  const failed = Array.isArray(body.unresponsive_engines)
+    ? body.unresponsive_engines
+    : [];
+  return {
+    web,
+    ...(failed.length > 0
+      ? {
+          warning: `Partial search result: ${failed.length} engine(s) did not answer (${failed
+            .map((u: any) => `${u.engine}: ${u.reason || "no reason"}`)
+            .join("; ")}).`,
+        }
+      : {}),
+  };
+}
