+// fcpi (M7; M5 review S1): the gateway's tag for the client's principal (16 hex digits), which it
+// writes into each job's origin as "fcpi:<tag>:..."; runWebScraper carries it to the adapter and
+// the parser request as internalOptions.fcpiOwner, for the retrieval service's owner-scoped caches.
+export function fcpiOwnerOf(origin: unknown): string | undefined {
+  return typeof origin === "string"
+    ? (/^fcpi:([0-9a-f]{16}):/.exec(origin)?.[1] ?? undefined)
+    : undefined;
+}
