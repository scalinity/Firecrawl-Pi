  "services": {
    "access-gateway": {
      "cap_drop": [
        "ALL"
      ],
      "cgroup_parent": "fcpi.slice",
      "cpus": 0.3,
      "command": null,
      "depends_on": {
        "firecrawl-core": {
          "condition": "service_started",
          "required": true
        },
        "nuq-postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "dns": [
        "192.0.2.1"
      ],
      "entrypoint": null,
      "environment": {
        "PI_ADMISSION_FILE": "/srv/admission/admission.json",
        "PI_ALLOWED_HOSTS": "http://127.0.0.1:3380,http://localhost:3380",
        "PI_ALLOWED_HOSTS_FILE": "/srv/clients/served-origins",
        "PI_ALLOWED_ORIGINS": "",
        "PI_ARTIFACT_ROOT": "/srv/artifacts",
        "PI_CAPABILITIES_FILE": "/srv/policy/capabilities.json",
        "PI_CLOUD_ACCESS_ENABLED": "false",
        "PI_CORE_TIMEOUT_MS": "110000",
        "PI_CORE_URL": "http://firecrawl-core:3002",
        "PI_CREDENTIALS_DIR": "/run/secrets",
        "PI_EXTRACT_URL": "http://10.231.9.20:3314",
        "PI_GATEWAY_CLIENTS_FILE": "/srv/clients/clients",
        "PI_GATEWAY_LISTEN_PORT": "3300",
        "PI_INCIDENT_GRANTS_DIR": "/srv/incidents/grants",
        "PI_INCIDENT_KEY_FILE": "/srv/incidents/public-key.pem",
        "PI_INCIDENT_OWNER_FILE": "/srv/incidents/owner.sha256",
        "PI_INCIDENT_REPORTS_DIR": "/srv/incidents/reports",
        "PI_INCIDENT_REQUESTS_DIR": "/srv/incidents/requests",
        "PI_MCP_URL": "http://10.231.8.20:3400",
        "PI_POSTGRES_DB": "postgres",
        "PI_POSTGRES_HOST": "nuq-postgres",
        "PI_POSTGRES_USER": "fcpi_gateway"
      },
      "hostname": "access-gateway",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "require('net').connect(3300,'127.0.0.1').on('connect',()=\u003eprocess.exit(0)).on('error',()=\u003eprocess.exit(1))"
        ],
        "timeout": "5s",
        "interval": "30s",
        "retries": 3,
        "start_period": "20s"
      },
      "image": "fcpi/access-gateway@sha256:274247d98ac057dfff81811baf8ff85f9b529f37cd68e0eb6139bc48b10806fb",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "167772160",
      "memswap_limit": "167772160",
      "networks": {
        "access": {},
        "api": {},
        "mcp": {
          "ipv4_address": "10.231.8.10"
        },
        "model": {
          "ipv4_address": "10.231.9.10"
        },
        "platform": {}
      },
      "pids_limit": 64,
      "platform": "linux/arm64",
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 3300,
          "published": "3380",
          "protocol": "tcp"
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "gateway_postgres_password",
          "target": "/run/secrets/gateway_postgres_password"
        },
        {
          "source": "gateway_retrieval_token",
          "target": "/run/secrets/gateway_retrieval_token"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "20s",
      "user": "3380:3380",
      "volumes": [
        {
          "type": "bind",
          "source": "/opt/firecrawl-pi/deploy/policies/capabilities.json",
          "target": "/srv/policy/capabilities.json",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/etc/firecrawl-pi/secrets/gateway",
          "target": "/srv/clients",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/firecrawl-pi/data/artifacts",
          "target": "/srv/artifacts",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/run/firecrawl-pi/admission",
          "target": "/srv/admission",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/firecrawl-pi/incidents/control/grants",
          "target": "/srv/incidents/grants",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/firecrawl-pi/incidents/control/requests",
          "target": "/srv/incidents/requests",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/firecrawl-pi/incidents/control/reports",
          "target": "/srv/incidents/reports",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/firecrawl-pi/incidents/control/public-key.pem",
          "target": "/srv/incidents/public-key.pem",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/var/lib/firecrawl-pi/incidents/control/owner.sha256",
          "target": "/srv/incidents/owner.sha256",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    },
    "browser-worker": {
      "cap_drop": [
        "ALL"
      ],
      "cgroup_parent": "fcpi.slice",
      "cpus": 1.5,
      "command": null,
      "entrypoint": null,
      "environment": {
        "HOME": "/tmp",
        "PI_BROWSER_EXTRAS_ENABLED": "true",
        "PI_BROWSER_LISTEN": "10.231.2.20:3320",
        "PI_CREDENTIALS_DIR": "/run/secrets"
      },
      "hostname": "browser-worker",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://10.231.2.20:3320/healthz',{signal:AbortSignal.timeout(3000)}).then(r=\u003eprocess.exit(r.ok?0:1),()=\u003eprocess.exit(1))"
        ],
        "timeout": "5s",
        "interval": "30s",
        "retries": 3,
        "start_period": "30s"
      },
      "image": "fcpi/browser@sha256:4d729d6ad77e455ef012744cd9a880a10e74da36f9cb90d94b03fc9e911313c3",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1610612736",
      "memswap_limit": "1610612736",
      "networks": {
        "browser": {
          "ipv4_address": "10.231.2.20"
        }
      },
      "pids_limit": 512,
      "platform": "linux/arm64",
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "browser_token_sha256",
          "target": "/run/secrets/browser_token_sha256"
        }
      ],
      "security_opt": [
        "no-new-privileges:true",
        "seccomp=/opt/firecrawl-pi/deploy/browser/seccomp.json"
      ],
      "shm_size": "268435456",
      "stop_grace_period": "15s",
      "tmpfs": [
        "/tmp:size=256m,mode=1777"
      ],
      "user": "3320:3320"
    },
    "firecrawl-core": {
      "cap_add": [
        "SETGID",
        "SETUID"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cgroup_parent": "fcpi.slice",
      "cpus": 2.25,
      "command": [
        "node",
        "dist/src/harness.js",
        "--start-docker"
      ],
      "depends_on": {
        "nuq-postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "rabbitmq": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        },
        "retrieval-service": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/fcpi/entrypoint.sh"
      ],
      "environment": {
        "DISABLE_WEBHOOK_DELIVERY": "true",
        "HOST": "0.0.0.0",
        "NODE_OPTIONS": "--max-old-space-size=384",
        "NUQ_WORKER_COUNT": "1",
        "PI_RETRIEVAL_URL": "http://retrieval-service:3310",
        "PORT": "3002",
        "POSTGRES_DB": "postgres",
        "POSTGRES_HOST": "nuq-postgres",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "fcpi_core",
        "SCRAPE_MAX_ATTEMPTS": "1",
        "SEARXNG_ENDPOINT": "http://retrieval-service:3310/searxng",
        "USE_DB_AUTHENTICATION": "false"
      },
      "hostname": "firecrawl-core",
      "healthcheck": {
        "test": [
          "CMD",
          "setpriv",
          "--reuid=3002",
          "--regid=3002",
          "--clear-groups",
          "node",
          "-e",
          "Promise.all(['http://127.0.0.1:3002/v0/health/liveness','http://127.0.0.1:3006/health'].map(u=\u003efetch(u,{signal:AbortSignal.timeout(5000)}).then(r=\u003er.ok,()=\u003efalse))).then(([a,w])=\u003e{console.log('api='+(a?'ok':'fail')+' worker='+(w?'ok':'fail'));process.exit(a\u0026\u0026w?0:1)})"
        ],
        "timeout": "15s",
        "interval": "30s",
        "retries": 3,
        "start_period": "3m0s"
      },
      "image": "fcpi/firecrawl-api@sha256:ea5e60e213d61ba3bc03b985cc78f633d241ed4b7ab63441ec48b84662d7c4d4",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2684354560",
      "memswap_limit": "2684354560",
      "networks": {
        "acquire": null,
        "api": null,
        "core": null
      },
      "pids_limit": 512,
      "platform": "linux/arm64",
      "pull_policy": "never",
