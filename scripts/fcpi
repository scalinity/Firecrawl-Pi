#!/usr/bin/env node
// fcpi — the platform's operator command (FIRECRAWL_PI_SPEC.md §25). M3 provides `status` and `jobs`;
// M8 completes the surface. It talks only to the private gateway, with a client token, so it shows only
// that token's principal's jobs.
//   FCPI_BASE_URL=http://127.0.0.1:3380 FCPI_TOKEN_FILE=<file> fcpi status [--json]
//   fcpi jobs [<job id>] [--limit N] [--json]
// FCPI_BASE_URL has no default: a missing one is an error, never a vendor endpoint. The token file holds
// one gateway token (scripts/m3/pi-client-token.sh writes them under /etc/firecrawl-pi/secrets/clients).
// Exit codes: 0 healthy or found; 1 core not live or ledger down; 2 usage or configuration; 3 HTTP error.
import { readFileSync } from "node:fs";
import { makeClient } from "../services/access/client.mjs";

const args = process.argv.slice(2);
const json = args.includes("--json");
const rest = args.filter((a) => a !== "--json");
const die = (code, msg) => { process.stderr.write(`fcpi: ${msg}\n`); process.exit(code); };

const [cmd, ...more] = rest;
if (!["status", "jobs"].includes(cmd)) die(2, "usage: fcpi status [--json] | fcpi jobs [<id>] [--limit N] [--json]");
if (!process.env.FCPI_BASE_URL) die(2, "FCPI_BASE_URL is not set (there is no default)");
if (!process.env.FCPI_TOKEN_FILE) die(2, "FCPI_TOKEN_FILE is not set");
let client;
try { client = makeClient({ baseUrl: process.env.FCPI_BASE_URL, token: readFileSync(process.env.FCPI_TOKEN_FILE, "utf8").trim(), timeoutMs: 20000 }); }
catch (e) { die(2, e.message); }

const show = (o) => process.stdout.write(json ? `${JSON.stringify(o, null, 2)}\n` : o);
const fail = (r) => die(3, `${r.status} ${r.json?.code ?? ""} ${r.json?.error ?? r.text.slice(0, 200)}`.trim());

if (cmd === "status") {
  const r = await client.call("platform.status");
  if (r.status !== 200) fail(r);
  const s = r.json;
  const healthy = s.core?.live === true && s.ledger?.ok === true;
  if (json) show(s);
  else show([
    `gateway   build ${s.build}, up ${s.uptimeSeconds} s, instance ${s.instance}`,
    `core      ${s.core?.live ? "live" : "NOT LIVE"} (${s.core?.ms} ms)`,
    `ledger    ${s.ledger?.ok ? "ok" : `DOWN ${s.ledger?.error ?? ""}`}`,
    `jobs      ${Object.entries(s.jobs ?? {}).map(([k, v]) => `${k}=${v}`).join(" ") || "none"}`,
    `archive   ${s.archive?.bytes ?? "?"} of ${s.archive?.quotaBytes} bytes`,
    `routes    ${s.capabilities?.routes?.length} enabled, ${s.capabilities?.notEnabled?.length} not enabled`,
    "",
  ].join("\n"));
  process.exit(healthy ? 0 : 1);
}

const limitAt = more.indexOf("--limit");
const limit = limitAt >= 0 ? Number(more[limitAt + 1]) : undefined;
const id = more.find((a, i) => !a.startsWith("--") && more[i - 1] !== "--limit");
if (id) {
  const r = await client.call("platform.job", { id });
  if (r.status !== 200) fail(r);
  const j = r.json.job;
  if (json) show(j);
  else show([
    `${j.id}  ${j.kind}  ${j.state}`,
    `created ${j.createdAt}  submitted ${j.submittedAt ?? "-"}  finished ${j.finishedAt ?? "-"}`,
    `upstream ${j.upstreamId ?? "-"} (${j.upstreamStatus ?? "-"})  completed ${j.completed ?? 0}/${j.total ?? 0}  archived ${j.archived}  errors ${j.errorCount}`,
    `results ${j.results}  kept until ${j.resultsExpireAt ?? "-"}`,
    ...(j.error ? [`error ${j.error.code}: ${j.error.message}`] : []),
    ...j.events.map((e) => `  ${e.at}  ${e.from ?? "-"} -> ${e.to}  ${e.detail ?? ""}`),
    "",
  ].join("\n"));
} else {
  const r = await client.call("platform.jobs", { query: { limit } });
  if (r.status !== 200) fail(r);
  if (json) show(r.json.jobs);
  else show(r.json.jobs.map((j) => `${j.id}  ${j.kind.padEnd(5)}  ${j.state.padEnd(20)}  ${j.createdAt}  ${j.archived} docs`).join("\n") + "\n");
}
