#!/usr/bin/env bash
# fcpi — the platform's operational command (FIRECRAWL_PI_SPEC.md §25), ON the Pi, installed as /usr/local/bin/fcpi.
# Every command acts on Compose project fcpi and the project's own paths only. Commands that read secrets, the
# operations state or Docker need root: run them with sudo.
#   fcpi status [--json]            services, capability readiness, queue, host, admission, incidents, backup age (from
#                                   another machine, with FCPI_BASE_URL and FCPI_TOKEN_FILE: the gateway's view, M3's client);
#                                   exit 0 healthy, 1 core or ledger not ready, 2 usage
#   fcpi jobs [<id>] [--as <label>] [--limit N] [--json]
#                                   job receipts through the gateway, as the operator or as a named client
#   fcpi usage [--period day|month|<N>d] [--json]
#                                   requests by route and tier, bytes, provider units, reserved against settled spend
#   fcpi verify <ops|functional|services>
#                                   a reproducible suite; results in /var/lib/firecrawl-pi/verify/<suite>-<UTC>.json
#   fcpi backup                     coordinated encrypted backup (scripts/ops/backup.sh)
#   fcpi backup-check               restic check of a 5 % data subset, then prune (weekly timer)
#   fcpi restore-test [--snapshot <id>] [--keep]
#                                   isolated restore and its proof (scripts/ops/restore-test.sh)
#   fcpi upgrade --plan <commit> | fcpi rollback --plan
#                                   read-only plans (scripts/ops/plan.sh); nothing is changed
#   fcpi doctor                     bounded, redacted diagnostic bundle (scripts/ops/doctor.sh)
#   fcpi hold <name> <seconds> | fcpi hold <name> --clear
#                                   pause new work by hand (the admission file), or release the pause
#   fcpi paid on|off|status         the paid-dispatch switch (/etc/firecrawl-pi/paid-dispatch.env); on and off recreate
#                                   the retrieval service
#   fcpi help restore               the disaster-recovery procedure
# Timers run: fcpi tick (every minute), fcpi probe (every five minutes), fcpi heartbeat (every minute, to the VPS
# watchdog), fcpi boot-record (at boot).
set -uo pipefail
HERE=$(dirname "$(readlink -f "$0")")
# From any machine with Node (the workstation, an agent's host), with FCPI_BASE_URL in the environment, even empty:
# status and jobs are M3's client (scripts/ops/client.mjs), through the private gateway with the token in
# FCPI_TOKEN_FILE, one principal's owner-safe view. Every other command, and these without FCPI_BASE_URL, run on the Pi.
case ${1:-} in status|jobs) [ -n "${FCPI_BASE_URL+set}" ] && exec node "$HERE/ops/client.mjs" "$@" ;; esac
. "$HERE/ops/lib.sh"
cmd=${1:-help}; shift || true
case $cmd in
  tick) exec bash "$HERE/ops/tick.sh" ;;
  probe) exec bash "$HERE/ops/probe.sh" ;;
  heartbeat) exec bash "$HERE/ops/heartbeat.sh" ;;
  boot-record) exec bash "$HERE/ops/boot-record.sh" ;;
  status) exec bash "$HERE/ops/status.sh" "$@" ;;
  backup) exec bash "$HERE/ops/backup.sh" "$@" ;;
  restore-test) exec bash "$HERE/ops/restore-test.sh" "$@" ;;
  doctor) exec bash "$HERE/ops/doctor.sh" "$@" ;;
  upgrade|rollback|release) exec bash "$HERE/ops/plan.sh" "$cmd" "$@" ;;
  verify) exec bash "$HERE/ops/verify.sh" "$@" ;;
  usage) exec bash "$HERE/ops/usage.sh" "$@" ;;
  backup-check)
    need_root
    . "$BACKUP_ENV" 2>/dev/null || die "no backup repository is configured"
    export RESTIC_REPOSITORY=$FCPI_RESTIC_REPOSITORY RESTIC_PASSWORD_FILE=$FCPI_RESTIC_PASSWORD_FILE RESTIC_CACHE_DIR=$STATE/restic-cache
    # The check shares the backup's lock: restic check beside a backup's forget contends for the repository's lock and
    # fails falsely. A skipped check leaves last-check.json as it was; the tick's backup_check_stale shows it.
    repo_lock || { logger -t fcpi-backup -p user.warning -- "backup-check skipped: the repository lock stayed held"; echo "fcpi: backup-check skipped: the repository lock stayed held" >&2; exit 3; }
    restic check --read-data-subset=5% >"$STATE/backup/check.log" 2>&1; rc=$?
    # Space the nightly retention forgot is reclaimed only after a passing check (spec §26).
    prc=null; if [ $rc = 0 ]; then restic prune >>"$STATE/backup/check.log" 2>&1; prc=$?; fi
    line=$(jq -cn --arg u "$(utc)" --argjson rc $rc --argjson prc "$prc" '{utc:$u,check_exit:$rc,prune_exit:$prc,result:(if $rc == 0 and $prc == 0 then "PASS" else "FAIL" end)}')
    printf '%s\n' "$line" | write_atomic "$STATE/backup/last-check.json" 0600; echo "$line"
    [ "$(jq -r .result <<<"$line")" = PASS ] ;;
  foreign)
    # Containers outside Compose project fcpi (throwaway fcpi.transient ones aside), to the journal and stdout (M1 R12).
    f=$(docker ps -a --format '{{.Names}}\t{{.Label "com.docker.compose.project"}}\t{{.Label "fcpi.transient"}}' 2>/dev/null | awk -F '\t' '$2 != "fcpi" && $3 == "" {print $1}' | tr '\n' ' ')
    if [ -n "$f" ]; then logger -t fcpi-stack -p user.warning -- "containers outside project fcpi: $f(dockerd's data-check gate assumes Docker serves this project alone)"; echo "foreign: $f"
    else echo "foreign: none"; fi ;;
  hold)
    need_root
    name=${1:?usage: fcpi hold <name> <seconds>|--clear}; [[ $name =~ ^[a-z0-9-]{1,32}$ ]] || die "a hold name is 1-32 of a-z 0-9 -"
    if [ "${2:-}" = --clear ]; then hold_clear "$name"; else [[ ${2:-} =~ ^[0-9]+$ ]] || die "seconds expected"; hold_set "$name" "$2"; fi
    cat "$ADMISSION" ;;
  paid)
    # The owner's paid-dispatch switch (spec §28.3), read by the retrieval service through an optional env_file: absent,
    # every start runs with paid dispatch off. The budget policy's caps still bound what a switched-on service spends.
    need_root
    f=/etc/firecrawl-pi/paid-dispatch.env
    case ${1:-status} in
      on) printf 'PI_PAID_DISPATCH_ENABLED=true\n' | write_atomic "$f" 0644 || die "could not write $f" ;;
      off) rm -f "$f" ;;
      status) ;;
      *) die "usage: fcpi paid on|off|status" ;;
    esac
    # A running retrieval service is recreated to read the switch; a stopped one (a restore, a rollback) is left stopped.
    if [ "${1:-status}" != status ] && [ -n "$(docker ps -q --filter name=^fcpi-retrieval-service-1$ 2>/dev/null)" ]; then
      docker compose -p fcpi -f "$REPO/deploy/compose.yaml" up -d --no-deps --force-recreate --wait --wait-timeout 300 retrieval-service >/dev/null 2>&1 || die "recreating the retrieval service failed"
    fi
    echo "paid dispatch: switch $([ -f "$f" ] && grep -qx 'PI_PAID_DISPATCH_ENABLED=true' "$f" && echo on || echo off), retrieval service $(docker exec fcpi-retrieval-service-1 printenv PI_PAID_DISPATCH_ENABLED 2>/dev/null || echo unset)" ;;
  jobs)
    need_root
    json=false as=ops limit=20 id=""
    while [ $# -gt 0 ]; do case $1 in --json) json=true; shift ;; --as) as=$2; shift 2 ;; --limit) limit=$2; shift 2 ;; *) id=$1; shift ;; esac; done
    [[ $as =~ ^[A-Za-z0-9_-]+$ ]] || die "bad client label"
    tok=/etc/firecrawl-pi/secrets/clients/$as.token; [ -r "$tok" ] || die "no token for client $as"
    if [ -n "$id" ]; then OPS_TOKEN=$tok gw GET "/platform/v1/jobs/$id"; else OPS_TOKEN=$tok gw GET "/platform/v1/jobs?limit=$limit"; fi
    [ "$GW_STATUS" = 200 ] || { echo "fcpi: gateway answered $GW_STATUS $(jq -r '(.code // "") + " " + (.error // "")' <<<"$GW_BODY" 2>/dev/null)" >&2; exit 3; }
    if [ $json = true ]; then jq . <<<"$GW_BODY"
    elif [ -n "$id" ]; then jq -r '.job | "\(.id)  \(.kind)  \(.state)\ncreated \(.createdAt)  finished \(.finishedAt // "-")  completed \(.completed // 0)/\(.total // 0)  archived \(.archived)  errors \(.errorCount)",
      (.events[]? | "  \(.at)  \(.from // "-") -> \(.to)  \(.detail // "")")' <<<"$GW_BODY"
    else jq -r '.jobs[] | "\(.id)  \(.kind)  \(.state)  \(.createdAt)  \(.archived) docs"' <<<"$GW_BODY"; fi ;;
  help)
    if [ "${1:-}" = restore ]; then sed -n '/^# RESTORE$/,/^# END RESTORE$/p' "$HERE/ops/restore-procedure.txt" 2>/dev/null || cat "$HERE/ops/restore-procedure.txt"
    else sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; fi ;;
  *) die "unknown command '$cmd' (fcpi help)" ;;
esac
