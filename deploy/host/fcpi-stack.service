[Unit]
Description=FCPI Compose stack (project fcpi)
Documentation=file:///opt/firecrawl-pi/deploy/compose.yaml
# Wants, not Requires, for docker.service: Requires carries a restart of dockerd to this unit,
# and its ExecStop (`docker compose stop`) then waits on the socket of the dockerd being
# restarted until TimeoutStopSec, which held a dockerd restart for 180 s and left this unit
# failed (evidence/M1/closeout/raw/docker-gate-requires.txt). Containers are revived by their
# restart policies behind the data check either way.
Requires=fcpi-data-check.service
Wants=docker.service network-online.target
After=fcpi-data-check.service docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The host's connected networks, for the guard and the retrieval service (M2); a failure does not
# stop the stack, because the retrieval service then refuses to acquire (fcpi-egress-local.sh).
ExecStartPre=-/etc/firecrawl-pi/fcpi-egress-local.sh
# `up --wait` returns once every service is healthy; a failed health wait fails the start.
ExecStart=/usr/bin/docker compose -p fcpi -f /opt/firecrawl-pi/deploy/compose.yaml up -d --wait --wait-timeout 900
# `stop` (not `down`): containers and networks stay, and restart policies do not revive
# explicitly stopped containers at the next daemon start. Containers that were running
# when the host lost power are revived by dockerd itself at its start; the drop-in
# docker.service.d/10-fcpi-data-check.conf runs the same check before every dockerd start,
# so that path is gated too.
ExecStop=/usr/bin/docker compose -p fcpi -f /opt/firecrawl-pi/deploy/compose.yaml stop
TimeoutStartSec=1000
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
