  "extraction": {
    "defaultModel": "gpt-4.1-mini-2025-04-14",
    "maxInputTokens": 32000,
    "maxOutputTokens": 4000,
    "maxRepairs": 1,
    "maxDocuments": 10,
    "maxDocumentBytes": 1048576,
    "maxChunks": 12,
    "maxSchemaBytes": 16384,
    "maxSchemaDepth": 6,
    "maxSchemaProperties": 100,
    "maxPromptChars": 4000,
    "requestTimeoutMs": 60000,
    "resultMaxBytes": 196608
  },
  "parsing": {
    "defaultParser": "llamaparse-cost-effective",
    "maxPages": 100,
    "maxBytes": 26214400,
    "cacheDays": 7,
    "jobTimeoutMs": 120000
  },
  "proxying": {
