    { "id": "fixture/fcpi-fixture-proxy@2026-09-26", "subject": "fcpi-fixture-proxy", "effectiveFrom": "2026-09-26", "effectiveTo": null,
      "microUsdPerGB": 4000000, "billing": "upload_plus_download_per_1e9_bytes", "source": "fixture: Decodo's price, no money" },
    { "id": "fixture/fcpi-fixture-proxy-race@2026-09-26", "subject": "fcpi-fixture-proxy-race", "effectiveFrom": "2026-09-26", "effectiveTo": null,
      "microUsdPerGB": 4000000, "billing": "upload_plus_download_per_1e9_bytes", "source": "fixture: Decodo's price, no money" },
    { "id": "zyte/api-payg@2026-09-27", "subject": "zyte-api", "effectiveFrom": "2026-09-27", "effectiveTo": null,
      "microUsdPerHttpRequest": 1270, "microUsdPerBrowserRequest": 16080, "billing": "successful_response_at_highest_tier",
      "source": "https://www.zyte.com/pricing/ and https://docs.zyte.com/zyte-api/pricing.html, observed 2026-09-27 (spec O06, O07): pay as you go per 1,000 successful responses, HTTP $0.13-$1.27 and browser $1.01-$16.08 by website tier (1-5); only successful responses are charged, and no answer reports its tier, so each is charged at tier 5" },
    { "id": "fixture/fcpi-fixture-zyte@2026-09-27", "subject": "fcpi-fixture-zyte", "effectiveFrom": "2026-09-27", "effectiveTo": null,
