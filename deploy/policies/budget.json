    "maxAttemptBytes": 10000000,
    "maxTunnelBytes": 2000000
  },
  "enhancing": {
    "defaultEnhancer": "zyte-api",
    "requestTimeoutMs": 40000,
    "maxResponseBytes": 37748736
  },
