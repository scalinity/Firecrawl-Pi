    "fixture": { "paid": false, "unit": "micro_usd", "caps": { "day": 5000000 } },
    "fixture_race": { "paid": false, "unit": "micro_usd", "caps": { "day": 100000 } },
    "fixture_parser": { "paid": false, "unit": "credits", "caps": { "day": 3000 } },
