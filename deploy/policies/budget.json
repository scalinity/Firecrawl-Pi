    { "id": "fixture/fcpi-fixture-zyte-small@2026-09-27", "subject": "fcpi-fixture-zyte-small", "effectiveFrom": "2026-09-27", "effectiveTo": null,
      "microUsdPerHttpRequest": 1270, "microUsdPerBrowserRequest": 16080, "billing": "successful_response_at_highest_tier", "source": "fixture: Zyte's tier-5 prices against a cap with room for one browser request, no money" }
