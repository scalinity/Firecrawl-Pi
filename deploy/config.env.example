# /etc/firecrawl-pi/config.env (root 0600): deployment values, no secrets.
# scripts/m1/pi-init.sh writes it once; PI_DATA_ID is generated then.
# Spec §29 names: PI_DATA_MOUNT_ID is the expected filesystem UUID of the data path.
PI_DATA_MOUNT_ID=15f4c6be-1102-4331-9904-f78e78afd1fd
PI_DATA_DIR=/srv/firecrawl-pi/data
PI_DATA_ID=<generated by pi-init.sh>
PI_COMPOSE_FILE=/opt/firecrawl-pi/deploy/compose.yaml
PI_CLOUD_ACCESS_ENABLED=false
