# FCPI M1 secrets: names, owners and modes only. No value ever enters Git.
# scripts/m1/pi-init.sh generates each missing file ON the Pi and never overwrites one.
# Directory /etc/firecrawl-pi/secrets is root:root 0700; every file is 0600.
# The owner is the uid that reads the file inside its container. Each service has a
# dedicated uid equal to its port; the images' default 999 is pihole on this host.
#
# name                      owner        consumer
postgres_password           5432:5432    nuq-postgres entrypoint (POSTGRES_PASSWORD_FILE, runs as uid 5432)
core_postgres_password      0:0          firecrawl-core wrapper (root) -> POSTGRES_PASSWORD for role fcpi_core (not the superuser's)
postgres_core_role_password 5432:5432    nuq-postgres initdb (020-fcpi-core-role.sh) sets fcpi_core's password; same value as core_postgres_password
rabbitmq_default_user_conf  5672:5672    rabbitmq conf.d fragment: default_user/default_pass for the first boot
redis_users_acl             6379:6379    redis-server aclfile: 'default' user by SHA-256 of the password; 'health' may only PING.
#                                        Known width: 'default' has +@all (incl. CONFIG, DEBUG, FLUSHALL); narrow it
#                                        against the command set M8's soak measures, not by guesswork (REVIEW.md R11).
core_redis_url              0:0          firecrawl-core wrapper -> REDIS_URL, REDIS_RATE_LIMIT_URL
core_nuq_rabbitmq_url       0:0          firecrawl-core wrapper -> NUQ_RABBITMQ_URL
gateway_token_hashes        3380:3380    access-gateway: '<label> sha256:<hex>' lines; never a plaintext token
clients/m1-verify.token     0:0          plaintext client token for scripts/m1 verification; not mounted into any container
#
# Also generated once, outside this directory:
#   /srv/firecrawl-pi/data/rabbitmq/.erlang.cookie   5672:5672 0400  (stable node identity; private)
#   /srv/firecrawl-pi/data/.fcpi-data-id            0:0     0644  (the project data ID; not a secret)
#
# M2 (scripts/m2/pi-init-m2.sh; created in pairs from one generated value, never overwritten)
retrieval_postgres_password       3310:3310  retrieval-service -> role fcpi_retrieval (DML on schema fcpi_retrieval only)
postgres_retrieval_role_password  5432:5432  nuq-postgres initdb (030-fcpi-retrieval.sh); same value as retrieval_postgres_password
core_retrieval_token              0:0        firecrawl-core wrapper (root) -> PI_RETRIEVAL_TOKEN, the core's credential for the retrieval service
retrieval_core_token_sha256       3310:3310  retrieval-service: 'sha256:<hex>' of core_retrieval_token; never the plaintext
retrieval_browser_token           3310:3310  retrieval-service -> its credential for the browser worker
browser_token_sha256              3320:3320  browser-worker: 'sha256:<hex>' of retrieval_browser_token; never the plaintext
#
# Also, outside this directory (not secrets):
#   /etc/firecrawl-pi/egress-local.cidrs   0:0 0644  the host's connected networks (fcpi-egress-local.sh)
