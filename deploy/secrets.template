# FCPI M1 secrets: names, owners and modes only. No value ever enters Git.
# scripts/m1/pi-init.sh generates each missing file ON the Pi and never overwrites one.
# Directory /etc/firecrawl-pi/secrets is root:root 0700; every file is 0600.
# The owner is the uid that reads the file inside its container. Each service has a
# dedicated uid equal to its port; the images' default 999 is pihole on this host.
#
# name                      owner        consumer
postgres_password           5432:5432    nuq-postgres entrypoint (POSTGRES_PASSWORD_FILE, runs as uid 5432)
core_postgres_password      0:0          firecrawl-core wrapper (root) -> POSTGRES_PASSWORD; same value as postgres_password
rabbitmq_default_user_conf  5672:5672    rabbitmq conf.d fragment: default_user/default_pass for the first boot
redis_users_acl             6379:6379    redis-server aclfile: 'default' user by SHA-256 of the password; 'health' may only PING
core_redis_url              0:0          firecrawl-core wrapper -> REDIS_URL, REDIS_RATE_LIMIT_URL
core_nuq_rabbitmq_url       0:0          firecrawl-core wrapper -> NUQ_RABBITMQ_URL
gateway_token_hashes        3380:3380    access-gateway: '<label> sha256:<hex>' lines; never a plaintext token
clients/m1-verify.token     0:0          plaintext client token for scripts/m1 verification; not mounted into any container
#
# Also generated once, outside this directory:
#   /srv/firecrawl-pi/data/rabbitmq/.erlang.cookie   5672:5672 0400  (stable node identity; private)
#   /srv/firecrawl-pi/data/.fcpi-data-id            0:0     0644  (the project data ID; not a secret)
