-- FCPI: the core's own PostgreSQL role, fcpi_core. It may read and write NuQ's tables and
-- nothing more. The tables, their schema and NuQ's pg_cron jobs stay the superuser's, so
-- fcpi_core cannot create triggers, rules or views on the tables, alter them, or create
-- anything in the schema. That matters because the cron jobs change these tables as the
-- superuser every 15 s: a trigger their owner attached would run with superuser rights.
-- The pinned core sends NuQ only DML and pg_notify() (no DDL, TRUNCATE or LISTEN in its
-- dist/src/services/worker/nuq.js).
-- The superuser keeps no password: local and loopback connections are trusted (pg_cron,
-- the healthcheck and the collectors use them), and nothing else logs in as it.
-- Run by the superuser through psql with the variable pw set from a secret file over stdin
-- (never on a command line). Idempotent. Callers: initdb/020-fcpi-core-role.sh (a new data
-- directory) and scripts/m1/pi-narrow-credentials.sh (the existing one).
\set ON_ERROR_STOP on
-- Neither the statement nor an error about it may reach the server log with the password.
SET log_statement = 'none';
SET log_min_error_statement = panic;
SELECT 'CREATE ROLE fcpi_core LOGIN' WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'fcpi_core') \gexec
ALTER ROLE fcpi_core WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT PASSWORD :'pw';
-- An install where fcpi_core owned the schema hands every object back to the superuser.
REASSIGN OWNED BY fcpi_core TO postgres;
REVOKE ALL ON SCHEMA nuq FROM fcpi_core;
REVOKE ALL ON ALL TABLES IN SCHEMA nuq FROM fcpi_core;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA nuq FROM fcpi_core;
GRANT USAGE ON SCHEMA nuq TO fcpi_core;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA nuq TO fcpi_core;
GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA nuq TO fcpi_core;
-- Tables and sequences a later nuq.sql adds get the same, and no more.
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA nuq GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO fcpi_core;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA nuq GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO fcpi_core;
ALTER ROLE postgres PASSWORD NULL;
